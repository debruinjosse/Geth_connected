NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
# Public WhatsApp support number in international format. Used by the support page live chat button.
NEXT_PUBLIC_SUPPORT_WHATSAPP_NUMBER=31613795467

# Optional automation settings for `npm run db:push` and `npm run dev` (predev hook).
# DATABASE_URL enables direct migration fallback when the Supabase CLI cannot spawn on Windows.
DATABASE_URL=
# SUPABASE_PROJECT_ID can be inferred from NEXT_PUBLIC_SUPABASE_URL, but setting it is clearer.
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=
# Optional for non-interactive Supabase CLI pushes when `supabase login` is not available.
SUPABASE_ACCESS_TOKEN=

# SMTP settings for app-generated emails through Nodemailer.
# Used for company invites, bulk-import invites, invoice emails, and calendar invite emails.
# TransIP mailbox: info@geth.pro
# Host: smtp.transip.email
# Port: 465
# Security: SSL/TLS enabled. SMTP_PASS must be the mailbox password, not the TransIP account password.
SMTP_HOST=smtp.transip.email
SMTP_PORT=465
SMTP_USER=info@geth.pro
SMTP_PASS=
SMTP_FROM="GETH <info@geth.pro>"
SMTP_REPLY_TO=info@geth.pro

# Invoice billing configuration for generated European invoice PDFs and invoice emails.
# Required in production before generating legal invoices.
# Seller legal name shown on invoice, for example the registered company/entity name.
GETH_INVOICE_SELLER_NAME=
# Optional seller VAT/tax registration number shown on invoice when available.
GETH_INVOICE_SELLER_VAT_NUMBER=
# Seller address shown on invoice. Use a single line or escaped newlines.
GETH_INVOICE_SELLER_ADDRESS=
# Seller invoice/support email shown on invoice.
GETH_INVOICE_SELLER_EMAIL=
# Payment IBAN / bank account shown on invoice. Must be the real receiving account in production.
GETH_INVOICE_PAYMENT_IBAN=
# Optional BIC/SWIFT shown on invoice when needed for international transfers.
GETH_INVOICE_PAYMENT_BIC=
# Optional bank name appended to generated invoice payment terms.
GETH_INVOICE_PAYMENT_BANK_NAME=
# Optional prefix for generated payment references, for example GETH.
GETH_INVOICE_PAYMENT_REFERENCE_PREFIX=GETH
# Payment term defaults used for invoice due date and invoice copy.
GETH_INVOICE_PAYMENT_TERMS_DAYS=14
GETH_INVOICE_PAYMENT_TERMS="Payment due within 14 days by bank transfer."
# VAT rate used for invoice totals. Set to the applicable production VAT rate.
GETH_INVOICE_VAT_RATE_PERCENT=21

# Calendar/demo booking configuration.
# The current /book-demo page is a client-side placeholder; these variables power
# the downloadable/sent final review calendar invite.
# Default is next Sunday at 13:00 UTC, matching 15:00 Amsterdam time during CEST.
GETH_REVIEW_MEETING_START_UTC=
GETH_REVIEW_MEETING_DURATION_MINUTES=60
GETH_REVIEW_MEETING_TITLE="GETH Connected Cards final project review"
GETH_REVIEW_MEETING_LOCATION=Online
GETH_REVIEW_MEETING_DESCRIPTION="Final review for QR scanning, invoices, translations, dashboards, imports, and launch readiness."
# Comma-separated attendee emails for the platform-admin calendar invite email route.
GETH_REVIEW_MEETING_ATTENDEES=

# Optional Stripe billing settings.
# The core app still works when these are empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs for seeded plans. Add these values in Supabase `plans.stripe_price_id`
# or update them through SQL/admin tooling after creating prices in Stripe.
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
