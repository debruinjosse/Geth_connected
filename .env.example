NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_DEMO_MODE=false

# Optional SMTP settings for Nodemailer invite emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GETH <hello@geth.com>"
SMTP_REPLY_TO=hello@geth.com

# Optional Stripe billing settings.
# The core app still works when these are empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs for seeded plans. Add these values in Supabase `plans.stripe_price_id`
# or update them through SQL/admin tooling after creating prices in Stripe.
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# Optional n8n translation webhook. If empty, the language switcher falls back
# to Google Translate's translated-page URL.
N8N_TRANSLATE_WEBHOOK_URL=
